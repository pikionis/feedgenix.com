{
    "openapi": "3.1.0",
    "info": {
        "title": "FeedGenix",
        "version": "0.0.1"
    },
    "servers": [
        {
            "url": "/api"
        }
    ],
    "paths": {
        "/health": {
            "get": {
                "operationId": "health",
                "description": "`200` when the database answers, `503` when it does not.",
                "summary": "Health check",
                "tags": [
                    "Health"
                ],
                "responses": {
                    "200": {
                        "description": "",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "status": {
                                            "type": "string",
                                            "const": "ok"
                                        },
                                        "database": {
                                            "type": "string",
                                            "const": "ok"
                                        }
                                    },
                                    "required": [
                                        "status",
                                        "database"
                                    ]
                                }
                            }
                        }
                    },
                    "503": {
                        "description": "",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "status": {
                                            "type": "string",
                                            "const": "degraded"
                                        },
                                        "database": {
                                            "type": "string",
                                            "const": "down"
                                        }
                                    },
                                    "required": [
                                        "status",
                                        "database"
                                    ]
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}