# FeedGenix. Written once by ops/provision.sh and never rewritten: edit it by hand, then deploy
# (or run `feedgenix-artisan optimize`). Mode 600, owner feedgenix. Never copy another app's keys here.
APP_NAME=FeedGenix
APP_ENV=${FG_APP_ENV}
APP_KEY=${FG_APP_KEY}
APP_DEBUG=false
APP_URL=https://${FG_DOMAIN}
FRONTEND_URL=https://${FG_DOMAIN}

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=daily
LOG_DAILY_DAYS=14
LOG_LEVEL=info
LOG_DEPRECATIONS_CHANNEL=null

# PostgreSQL over its unix socket with peer authentication: the OS user is the database role, so no
# database password exists anywhere. The role is never SUPERUSER or BYPASSRLS (feedgenix-check).
DB_CONNECTION=pgsql
DB_HOST=/var/run/postgresql
DB_PORT=${FG_PG_PORT}
DB_DATABASE=feedgenix
DB_USERNAME=feedgenix
DB_PASSWORD=

# FeedGenix's private Redis, on its unix socket. Never 127.0.0.1: on a shared host that is another
# application's Redis (the deploy receiver refuses to deploy with a TCP host here).
REDIS_CLIENT=phpredis
REDIS_HOST=/run/feedgenix-redis/redis.sock
REDIS_PORT=0
REDIS_PASSWORD=null

CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# open | invite | closed. The private beta runs on invites: feedgenix-artisan invites:create
FEEDGENIX_REGISTRATION=invite
SANCTUM_STATEFUL_DOMAINS=${FG_DOMAIN}

# The largest feed one import reads, uncompressed, whatever the plan allows. Unset = 2 GB, right for
# the shared beta server. A dedicated server sized for it raises it to the largest plan (50 GB):
# FEEDGENIX_FEED_MAX_BYTES=53687091200

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# AI (ADR 0004, ADR 0016). Off until the provider keys are set, every routed model's prices are
# confirmed in config/ai.php and the workspace has credits (credits:grant). Gemini: paid tier only.
FEEDGENIX_AI_ENABLED=false
FEEDGENIX_USD_TO_EUR=0.92
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# Until a mail provider is set up, emails (verification, password reset) are written whole to
# storage/logs/mail-YYYY-MM-DD.log (the "mail" channel, which logs at debug level).
MAIL_MAILER=log
MAIL_LOG_CHANNEL=mail
MAIL_FROM_ADDRESS="hello@feedgenix.com"
MAIL_FROM_NAME="${APP_NAME}"
